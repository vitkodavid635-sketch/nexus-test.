
from typing import Any, List

from base_plugin import BasePlugin
from ui.settings import Header, Text

__id__ = "nexus_test"
__name__ = "NEXUS TEST"
__description__ = "Тест установки собственного плагина NEXUS AI."
__author__ = "NEXUS"
__version__ = "1.0.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"
__category__ = ["tools", "integrations"]


class NexusTestPlugin(BasePlugin):
    def on_plugin_load(self):
        self.logger.info("NEXUS TEST успешно загружен")

    def create_settings(self) -> List[Any]:
        return [
            Header(text="NEXUS TEST"),
            Text(
                text="Плагин установлен и запущен!",
                subtext="Если ты видишь этот экран, загрузка собственного плагина работает.",
                icon="msg_info",
            ),
        ]
